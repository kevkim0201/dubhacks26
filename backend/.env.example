# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://yvkbtnukbwodzvcuihuu.supabase.co
# Only needed if your project still uses the legacy HS256 JWT secret.
# Projects on the new asymmetric signing keys are verified via JWKS automatically.
SUPABASE_JWT_SECRET=
# Server-only key from Supabase Project Settings -> API Keys. Never put this in the extension.
SUPABASE_SERVICE_ROLE_KEY=
# Shared only with a trusted server-side voice/AI service that submits its recommendation.
INTERNAL_SERVICE_TOKEN=
# Comma-separated. Add chrome-extension://<your-extension-id> once you know it.
CORS_ORIGINS=http://localhost:5173

# ElevenLabs Conversational AI Agent (Eleven v4 Turbo)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
