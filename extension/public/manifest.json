{
  "manifest_version": 3,
  "name": "DubHacks26",
  "version": "0.1.0",
  "description": "DubHacks26 Chrome extension",
  "action": {
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage"],
  "host_permissions": ["http://localhost:8000/*"]
}
