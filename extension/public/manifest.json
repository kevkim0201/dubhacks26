{
  "manifest_version": 3,
  "name": "Nook",
  "version": "0.1.0",
  "description": "Pause before you purchase. Talk it through with Pip at checkout.",
  "action": {
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://yvkbtnukbwodzvcuihuu.supabase.co/*",
    "http://localhost:8000/*"
  ]
}
